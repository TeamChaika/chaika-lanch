# Server-only. Never use NEXT_PUBLIC_ for these values.
APP_ORIGINS=https://lunch.chaika.team
SESSION_SECRET=
OWNER_PASSWORD_HASH=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_PREFIX=chaika-lanch
# Optional: isolated CMS test prefix. Leave unset in production.
# CMS_STORAGE_PREFIX=chaika-lanch-admin-test
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Local development only: MENU_STORE=local

# QR Manager: disabled | sandbox | live. Server-only keys.
# Public test key is available in https://docs.qrmanager.ru/docs/v2
QRM_MODE=disabled
QRM_API_KEY=
# Production key and HTTPS API origin supplied by QR Manager:
QRM_LIVE_API_KEY=
QRM_API_BASE_URL=
